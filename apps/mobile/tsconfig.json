{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@screens": [
        "./src/screens"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@styles": [
        "./src/styles"
      ],
      "@typ/*": [
        "./src/types/*"
      ],
      "@contexts/*": [
        "./src/svc/contexts/*"
      ],
      "@images/*": [
        "./assets/images/*"
      ],
      "@apis/*": [
        "./src/svc/apis/*"
      ],
      "@storages/*": [
        "./src/svc/storages/*"
      ],
      "@dt/*": [
        "./src/svc/data/*"
      ],
      "@env": [
        "./src/shims/env"
      ],
      "react-native-linear-gradient": [
        "./src/shims/linear-gradient"
      ]
    }
  },
  "include": [
    "src",
    "App.tsx",
    "index.js",
    "declarations.d.ts"
  ]
}
